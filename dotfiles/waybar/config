{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["sway/workspaces"],
  "modules-right": [
    "custom/keyboard",
    "custom/download",
    "custom/upload",
    "network",
    "custom/date",
    "custom/time",
    "tray",
    "custom/logout",
    "custom/sleep",
    "custom/restart",
    "custom/power"
  ],
  
  // Workspaces
  "sway/workspaces": {
    "format": "{name}",
    "all-outputs": true
  },

  // Network
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "",
    "format-disconnected": "⚠ Offline",
    "tooltip-format": "{ifname}: {ipaddr}",
    "interval": 5
  },

  // Custom modules
  "custom/upload": {
    "format": "↑ {}",
    "interval": 1,
    "exec": "bash -c \"echo 'scale=1; $(cat /sys/class/net/[ew]*/statistics/tx_bytes | awk '{sum += $1} END {print sum}' | numfmt --to=si --format=%f)/1024' | bc\"",
    "exec-if": "ip link show | grep -q 'state UP'"
  },
  "custom/download": {
    "format": "↓ {}",
    "interval": 1,
    "exec": "bash -c \"echo 'scale=1; $(cat /sys/class/net/[ew]*/statistics/rx_bytes | awk '{sum += $1} END {print sum}' | numfmt --to=si --format=%f)/1024' | bc\"",
    "exec-if": "ip link show | grep -q 'state UP'"
  },
  "custom/keyboard": {
    "format": "⌨ {}",
    "interval": 1,
    "exec": "swaymsg -t get_inputs | jq -r '.[] | select(.type == \"keyboard\") | .xkb_active_layout_name | .[0:2]' | head -n 1"
  },
  "custom/time": {
    "format": "🕒 {:%H:%M:%S}",
    "interval": 1
  },
  "custom/date": {
    "format": "📅 {:%d-%m-%Y}",
    "interval": 60
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "systemctl poweroff"
  },
  "custom/restart": {
    "format": "🔄",
    "on-click": "systemctl reboot"
  },
  "custom/sleep": {
    "format": "🌙",
    "on-click": "systemctl suspend"
  },
  "custom/logout": {
    "format": "🚪",
    "on-click": "swaymsg exit"
  },

  // Tray
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}